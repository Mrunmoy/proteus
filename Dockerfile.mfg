# Proteus MFG image — the manufacturing test-station tooling + PySide6 GUI + the code
# formatters, all in Docker so nothing is installed on the host.
#
#   ./build.py --mfg-tools        # build this image (proteus-mfg)
#   ./build.py --mfg-tests        # headless GUI/controller unit tests
#   ./build.py --run-mfg          # the GUI (needs X11 + USB, see docker-compose.yml)
#   ./build.py --format           # clang-format (C/C++) + black (Python)
#
# Event-driven stack: QtSerialPort (RPC), QProcess (picotool), pyudev (USB events).
FROM python:3.12-slim

# Qt6/PySide6 runtime libs (xcb platform plugin) + libudev for pyudev + USB tooling
# + clang-format for the C/C++ formatter target.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 libegl1 libglib2.0-0 libdbus-1-3 libfontconfig1 libfreetype6 \
        libx11-6 libx11-xcb1 libxext6 libxrender1 libsm6 libice6 \
        libxcb1 libxcb-cursor0 libxcb-glx0 libxcb-icccm4 libxcb-image0 \
        libxcb-keysyms1 libxcb-randr0 libxcb-render0 libxcb-render-util0 \
        libxcb-shape0 libxcb-shm0 libxcb-sync1 libxcb-util1 libxcb-xfixes0 \
        libxcb-xinerama0 libxcb-xkb1 libxkbcommon0 libxkbcommon-x11-0 \
        libudev1 usbutils clang-format \
        libusb-1.0-0 libcap2 libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir PySide6==6.8.* pyserial==3.5 pyudev==0.24.* black==24.*

# picotool runs DIRECTLY in this container (it's privileged + has /dev/bus/usb) — the GUI
# must NOT shell out to a nested `docker run`. Reuse the binary already built in the
# proteus-picotool image instead of rebuilding it here.
COPY --from=proteus-picotool /usr/local/bin/picotool /usr/local/bin/picotool

WORKDIR /work
ENV PYTHONPATH=/work/tools/mfg:/work/tools/mfg/gui
ENV QT_QPA_PLATFORM=xcb
